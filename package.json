{
  "name": "@omicronenergy/oscd-editor-source",
  "version": "0.0.5",
  "description": "OpenSCD Editor Plugin which allows users to view the raw IEC 61850 SCL Markup (and edit it).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-editor-source.git"
  },
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-editor-source/issues"
  },
  "homepage": "https://openscd.org",
  "keywords": [
    "OpenSCD",
    "iec81650"
  ],
  "contributors": [
    "OMICRON Electronics GmbH"
  ],
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/oscd-editor-source.js",
    "./oscd-editor-source.js": "./dist/oscd-editor-source.js"
  },
  "files": [
    "/dist/",
    "!/dist/*.spec.*",
    "!/dist/*.test.*"
  ],
  "scripts": {
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "start": "oscd start",
    "start:bundle": "oscd start-bundle",
    "build": "oscd build",
    "bundle": "oscd bundle",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "test:visual": "oscd test --visual",
    "test:update": "oscd test --update",
    "updates": "oscd updates",
    "deploy": "oscd deploy",
    "prepare": "oscd install-hooks"
  },
  "dependencies": {
    "@omicronenergy/oscd-background-editv1": "^0.0.7",
    "@omicronenergy/oscd-menu-commons": "^0.0.3",
    "@omicronenergy/oscd-shell": "^0.0.18",
    "@omicronenergy/oscd-ui": "^0.1.4",
    "@open-wc/scoped-elements": "^3.0.10",
    "@openscd/oscd-api": "^0.1.6",
    "@webcomponents/scoped-custom-element-registry": "^0.0.11",
    "lit": "^3.3.3",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@omicronenergy/oscd-tooling": "^0.0.8",
    "@open-wc/testing": "^4.0.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "0.11.1"
  }
}
